# DoNext — client build-time variables (copy to client/.env)
# These are embedded into the public JavaScript bundle. NEVER put secrets here.

# API origin. Leave empty when the API is served from the same origin (recommended for web).
# REQUIRED for Capacitor iOS/Android builds, e.g. https://donext.dewantech.com
VITE_API_URL=

# Sub-path the web app is hosted under, e.g. /todo/ for https://dewantech.com/todo/
VITE_BASE_PATH=/
